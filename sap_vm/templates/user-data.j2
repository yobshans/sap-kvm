#cloud-config

hostname: {{ vm_hostname }}
fqdn: {{ vm_fqdn }}
manage_etc_hosts: false
disable_root: false
ssh_pwauth: true
selinux:
  mode: permissive

users:
  - name: root
    lock_passwd: false
    shell: /bin/bash

chpasswd:
  expire: false
  users:
    - name: root
      password: "{{ vm_root_password }}"
      type: text

bootcmd:
  # Guest latency cmdline (mirrors hypervisor host_tuning where useful):
  # - transparent_hugepage={{ vm_guest_thp }} (default madvise): HANA can
  #   madvise(MADV_HUGEPAGE) without "always" compaction stalls (SAP Note
  #   2131662) or "never" removing hugepages entirely.
  # - mitigations=off: disable Spectre/MDS/etc. for benchmark throughput.
  # - intel_idle.max_cstate=1 processor.max_cstate=1: cap idle at C1 to
  #   avoid deep-C-state wake-up latency.
  - grubby --update-kernel=ALL --remove-args="transparent_hugepage mitigations intel_idle.max_cstate processor.max_cstate" --args="transparent_hugepage={{ vm_guest_thp }} mitigations=off intel_idle.max_cstate=1 processor.max_cstate=1"
  - [ sh, -c, "grep -qw transparent_hugepage={{ vm_guest_thp }} /proc/cmdline && grep -qw mitigations=off /proc/cmdline && grep -qw intel_idle.max_cstate=1 /proc/cmdline && grep -qw processor.max_cstate=1 /proc/cmdline || reboot" ]
  # Guest haltpoll: raise wake-up busy-wait from the kernel default 200µs
  # to vm_guest_halt_poll_ns (default 400µs) for HANA latency-sensitive ops.
  - [ sh, -c, "modprobe haltpoll 2>/dev/null || true; echo {{ vm_guest_halt_poll_ns }} > /sys/module/haltpoll/parameters/guest_halt_poll_ns 2>/dev/null || true" ]

write_files:
  - path: /etc/ssh/sshd_config.d/00-sap.conf
    permissions: "0644"
    content: |
      PermitRootLogin yes
      PasswordAuthentication yes
      KbdInteractiveAuthentication yes
  - path: /etc/tmpfiles.d/sap-thp.conf
    permissions: "0644"
    content: |
      w /sys/kernel/mm/transparent_hugepage/enabled - - - - {{ vm_guest_thp }}
      w /sys/kernel/mm/transparent_hugepage/defrag - - - - {{ vm_guest_thp }}
  - path: /etc/modprobe.d/haltpoll-tuning.conf
    permissions: "0644"
    content: |
      options haltpoll guest_halt_poll_ns={{ vm_guest_halt_poll_ns }}

yum_repos:
{% for repo in vm_repos %}
  {{ repo.name }}:
    name: {{ repo.description }}
    baseurl: {{ repo.baseurl }}
    enabled: true
    gpgcheck: false
    skip_if_unavailable: true
{% endfor %}

packages:
  - qemu-guest-agent
{% for pkg in vm_packages %}
  - {{ pkg }}
{% endfor %}

runcmd:
  - passwd -u root || true
  - sed -i 's/^[[:space:]]*PasswordAuthentication.*/PasswordAuthentication yes/' /etc/ssh/sshd_config.d/50-redhat.conf
  - systemctl enable --now sshd
  - systemctl reload sshd || systemctl restart sshd || true
  - systemctl enable --now qemu-guest-agent || true
  # Guest IRQs stay on the vCPU the device is bound to; irqbalance moving
  # them across vCPUs adds latency noise for HANA/PBO.
  - systemctl stop irqbalance || true
  - systemctl disable irqbalance || true
  - growpart /dev/vda 4 || true
  - xfs_growfs / || resize2fs /dev/vda4 || true
